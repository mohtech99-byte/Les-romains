# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# PostgreSQL database (used by src/db/index.ts via Drizzle ORM)
# -----------------------------------------------------------------------------
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="MY_DB_PASSWORD"
SQL_DB_NAME="les_romains"

# -----------------------------------------------------------------------------
# Supabase (server-side). Used by src/lib/storage.ts for media uploads and by
# src/lib/supabase-admin.ts / src/middleware/auth.ts to verify Supabase Auth
# access tokens sent by the frontend. The service role key is secret and must
# only ever be used on the server - never expose it to the browser.
# If left unset, media uploads fall back to local disk storage under /uploads.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://MY_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="media"

# -----------------------------------------------------------------------------
# Supabase (client-side / browser). Used by src/lib/supabase.ts for Supabase
# Authentication (email/password login) in the admin dashboard. The anon key
# is safe to expose publicly - it only grants the permissions your Supabase
# Row Level Security policies allow. Vite exposes any VITE_-prefixed variable
# to the browser bundle, so never put the service role key here.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://MY_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# -----------------------------------------------------------------------------
# Admin access (used by src/middleware/auth.ts)
# Comma-separated list of Supabase Auth user emails that should automatically
# receive the 'admin' role the first time they sign in.
# Anyone else who signs in starts as 'editor' and must be promoted manually
# in the database by an existing admin/manager.
# -----------------------------------------------------------------------------
ADMIN_EMAILS="sadeco005@gmail.com"

# -----------------------------------------------------------------------------
# Security
# Comma-separated list of allowed frontend origins for CORS in production,
# e.g. "https://lesromains.com,https://www.lesromains.com".
# Leave unset during local development to allow all origins.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=""

# Port the Express server listens on. Most hosting platforms (e.g. Cloud Run)
# inject this automatically; only set it manually for local development if
# you need a port other than 3000.
PORT="3000"

# -----------------------------------------------------------------------------
# Email (Resend) — used by src/lib/email.ts to send newsletter broadcasts,
# order tracking status updates, and quotation PDFs by email.
# Sign up free at https://resend.com, verify your sending domain (or use
# their shared onboarding@resend.dev sender for testing), then create an API
# key under Resend Dashboard > API Keys.
# If RESEND_API_KEY is left unset, all email-sending features are disabled
# gracefully (the app logs a warning and returns a clear error to the admin
# UI) — nothing else breaks.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="LES ROMAINS <onboarding@resend.dev>"

